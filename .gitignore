# =============================================================================
# Build output, generated files, caches, logs, temporary and system-specific
# files for this C++ (CMake/vcpkg) + Python (CI tooling) repository.
# Anything listed here must never be committed; if a generated file is ever
# needed in the tree, add an explicit "!" exception next to its rule (see the
# CI fixture logs below).
# =============================================================================

# -----------------------------------------------------------------------------
# Build directories
# -----------------------------------------------------------------------------
.vs/
.vscode/
build/
build_test/
!tests/integration/build/
cmake/open-cpp-coverage.cmake
cmake-build/
cmake-build-*/
__cmake_systeminformation/
prefix/

# vcpkg manifest-mode install output (re-created by `vcpkg install` / `cmake --preset`)
vcpkg_installed/

# Upstream dmidecode reference clones, populated by
# `python scripts/fetch_upstream_references.py` from
# scripts/upstream_references.json (see CLAUDE.md). Both upstreams are
# GPL-2.0-or-later: this ignore rule is load-bearing for license isolation
# and must not be removed - nothing under c-versions/ may ever be tracked.
/c-versions/

# -----------------------------------------------------------------------------
# C++ / CMake / Ninja generated files
# -----------------------------------------------------------------------------
